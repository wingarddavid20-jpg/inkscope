# Copy this file to .env.local and fill in your keys:
#   cp .env.example .env.local

# Alchemy RPC key — powers Tydro on-chain reads (TVL, reserves, APYs).
# Falls back to the public Ink RPC if unset.
NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_key_here

# Ink RPC URL (documented alias; the app derives the Alchemy URL from the
# key above, with a public RPC fallback).
NEXT_PUBLIC_INK_RPC_URL=https://ink-mainnet.g.alchemy.com/v2/your_key_here

# Goldsky subgraph endpoint — liquidity flow (Bridge + CEX) panel.
# Wins over NEXT_PUBLIC_GRAPHQL_ENDPOINT for the liquidity panel.
NEXT_PUBLIC_GOLDSKY_ENDPOINT=your_goldsky_endpoint_here

# Goldsky subgraph endpoint — Tydro Aave V3 reserves (used by the Tydro
# panel; falls back to Alchemy RPC if unset).
NEXT_PUBLIC_GRAPHQL_ENDPOINT=your_goldsky_tydro_endpoint_here

# Optional: OpenSea API key — used by the Trending NFTs panel.
NEXT_PUBLIC_OPENSEA_API_KEY=your_opensea_key_here
